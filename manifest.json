{
  "manifest_version": 3,
  "name": "剪贴板守卫 · 地址防替换",
  "version": "1.2.0",
  "description": "拦截常见网页剪贴板写入，在粘贴前核对手动复制的文本。可锁定核对记录；纯本地运行。",
  "minimum_chrome_version": "119",
  "permissions": ["storage", "clipboardRead", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "剪贴板守卫" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-guard.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js", "preview-host.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [{ "resources": ["preview.html"], "matches": ["http://*/*", "https://*/*"] }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
